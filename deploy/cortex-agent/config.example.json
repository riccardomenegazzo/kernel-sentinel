{
  "service": "checkout",
  "namespace": "production",
  "deployment": "checkout",
  "slo_target": 0.999,
  "error_rate_query": "sum(rate(http_requests_total{service=\"checkout\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"checkout\"}[5m])), 1)",
  "p95_query": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"checkout\"}[5m])))",
  "trace_query": "{ resource.service.name = \"checkout\" && status = error }",
  "log_query": "{app=\"checkout\"} |= \"error\"",
  "min_confidence": 0.9,
  "min_ready_replicas": 2,
  "required_bad_cycles": 2,
  "execute": false,
  "prometheus_url": "http://prometheus-operated.monitoring.svc:9090",
  "tempo_url": "http://tempo.monitoring.svc:3200",
  "loki_url": "http://loki.monitoring.svc:3100",
  "audit_path": "/var/lib/cortex/audit.jsonl",
  "audit_hmac_env": "CORTEX_AUDIT_HMAC",
  "poll_seconds": 30,
  "rollout_timeout_seconds": 120,
  "verify_delay_seconds": 30,
  "max_revision_age_seconds": 1800,
  "cooldown_seconds": 600
}
